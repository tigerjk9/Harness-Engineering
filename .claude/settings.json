{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "RESULT=$(bash .claude/skills/verify/verify.sh 2>/dev/null | tail -1); echo \"  🔍 harness: $RESULT\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/system-check.sh --brief 2>/dev/null; echo '  💡 세션 시작: progress.md를 먼저 읽어보세요'"
          }
        ]
      }
    ]
  }
}
